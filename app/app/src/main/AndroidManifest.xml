        TextView reports = label("QUICK REPORTS", 17, dark, true);
        reports.setPadding(3, 20, 0, 10);
        root.addView(reports);

        LinearLayout reportRow = horizontal();
        reportRow.addView(reportButton("Daily", "daily"));
        reportRow.addView(reportButton("Weekly", "weekly"));
        reportRow.addView(reportButton("Monthly", "monthly"));
        root.addView(reportRow);

        Button excel = new Button(this);
        excel.setText("⇩  EXPORT EXCEL FILE");
        excel.setTextColor(white);
        excel.setBackgroundTintList(
            android.content.res.ColorStateList.valueOf(green));
        root.addView(excel);
