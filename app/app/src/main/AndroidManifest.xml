    void formDialog(String title, LinearLayout box, Runnable save) {
        box.setPadding(18, 8, 18, 8);
        ScrollView s = new ScrollView(this);
        s.addView(box);
        new AlertDialog.Builder(this).setTitle(title)
            .setView(s).setNegativeButton("Cancel", null)
            .setPositiveButton("Save", (d, w) -> save.run()).show();
    }

    double val(EditText e) {
        try { return Double.parseDouble(e.getText().toString()); }
        catch (Exception x) { return 0; }
    }

    void report(String period) {
        String start = date();
        if (period.equals("weekly"))
            start = new SimpleDateFormat("yyyy-MM-dd", Locale.US)
                .format(new Date(System.currentTimeMillis() - 6L * 86400000));
        if (period.equals("monthly")) start = date().substring(0, 8) + "01";

        SQLiteDatabase d = db.getReadableDatabase();
        String where = "date >= ? AND date <= ?";
        String[] args = {start, date()};
        double income = query(d, "SELECT IFNULL(SUM(service_fee),0) FROM bookings WHERE " + where, args);
        double govt = query(d, "SELECT IFNULL(SUM(gov_fee),0) FROM bookings WHERE " + where, args);
        double exp = query(d, "SELECT IFNULL(SUM(amount),0) FROM expenses WHERE " + where, args);
        double dueValue = query(d, "SELECT IFNULL(SUM(due),0) FROM bookings WHERE " + where, args);

        new AlertDialog.Builder(this).setTitle(period.toUpperCase() + " REPORT")
            .setMessage("From: " + start + "\nTo: " + date() +
                "\n\nService Charges: Rs. " + income +
                "\nGovernment Fees: Rs. " + govt +
                "\nShop Expenses: Rs. " + exp +
                "\nCustomer Due: Rs. " + dueValue +
                "\n\nBusiness Profit: Rs. " + (income - exp))
            .setPositiveButton("Close", null).show();
    }

    double query(SQLiteDatabase d, String sql, String[] args) {
        Cursor c = d.rawQuery(sql, args);
        double x = c.moveToFirst() ? c.getDouble(0) : 0;
        c.close();
        return x;
    }

    void showRecords(String title, String sql) {
        Cursor c = db.getReadableDatabase().rawQuery(sql, null);
        StringBuilder s = new StringBuilder();
        while (c.moveToNext()) {
            for (int i = 0; i < c.getColumnCount(); i++)
                s.append(c.getColumnName(i)).append(": ")
                 .append(c.getString(i)).append("\n");
            s.append("----------------\n");
        }
        c.close();
        if (s.length() == 0) s.append("No records yet.");
        new AlertDialog.Builder(this).setTitle(title).setMessage(s.toString())
            .setPositiveButton("Close", null).show();
    }

    void exportCSV() {
        Intent i = new Intent(Intent.ACTION_CREATE_DOCUMENT);
        i.addCategory(Intent.CATEGORY_OPENABLE);
        i.setType("text/csv");
        i.putExtra(Intent.EXTRA_TITLE, "AlSiddiq_Accounts.csv");
        startActivityForResult(i, 10);
    }

    @Override
    protected void onActivityResult(int r, int result, Intent data) {
        super.onActivityResult(r, result, data);
        if (r == 10 && result == RESULT_OK && data != null) {
            try {
                StringBuilder csv = new StringBuilder();
                csv.append("Date,Customer,Mobile,Village,Service,Government Fee,Service Fee,Total,Paid,Due\n");
                Cursor c = db.getReadableDatabase().rawQuery(
                    "SELECT date,name,mobile,village,service,gov_fee,service_fee,total,paid,due FROM bookings", null);
                while (c.moveToNext()) {
                    for (int j = 0; j < 10; j++) {
                        if (j > 0) csv.append(",");
                        csv.append("\"").append(c.getString(j) == null ? "" :
                            c.getString(j).replace("\"", "\"\"")).append("\"");
                    }
                    csv.append("\n");
                }
                c.close();
                java.io.OutputStream out = getContentResolver().openOutputStream(data.getData());
                out.write(csv.toString().getBytes("UTF-8"));
                out.close();
                msg("Excel-compatible CSV exported");
            } catch (Exception e) { msg("Export error"); }
        }
    }

    void openNav(String name) {
        if (name.contains("Home")) home();
        else if (name.contains("History")) showRecords("Bookings",
            "SELECT date,name,service,total,paid,due FROM bookings ORDER BY id DESC");
        else if (name.contains("Settings"))
            new AlertDialog.Builder(this).setTitle("Settings")
                .setMessage("Al-Siddiq Shop Manager\nGreen & White Edition")
                .setPositiveButton("OK", null).show();
        else if (name.contains("Backup"))
            msg("Use Export Excel File to save your records.");
        else msg("Al-Siddiq Shop Manager");
    }

    void msg(String s) {
        Toast.makeText(this, s, Toast.LENGTH_LONG).show();
    }

    class DB extends SQLiteOpenHelper {
        DB(Context c) { super(c, "alsiddiq_new.db", null, 1); }

        public void onCreate(SQLiteDatabase d) {
            d.execSQL("CREATE TABLE bookings (id INTEGER PRIMARY KEY AUTOINCREMENT,date TEXT,name TEXT,mobile TEXT,village TEXT,service TEXT,gov_fee REAL,service_fee REAL,total REAL,paid REAL,due REAL)");
            d.execSQL("CREATE TABLE expenses (id INTEGER PRIMARY KEY AUTOINCREMENT,date TEXT,category TEXT,details TEXT,amount REAL)");
            d.execSQL("CREATE TABLE services (id INTEGER PRIMARY KEY AUTOINCREMENT,date TEXT,name TEXT,tracking TEXT,reference TEXT,total REAL,gov REAL,paid REAL,status TEXT)");
            d.execSQL("CREATE TABLE printer (id INTEGER PRIMARY KEY AUTOINCREMENT,date TEXT,opening REAL,closing REAL,paper REAL,income REAL)");
            d.execSQL("CREATE TABLE stock (id INTEGER PRIMARY KEY AUTOINCREMENT,date TEXT,item TEXT,quantity REAL,cost REAL)");
        }

        public void onUpgrade(SQLiteDatabase d, int oldVersion, int newVersion) {}
    }
}
