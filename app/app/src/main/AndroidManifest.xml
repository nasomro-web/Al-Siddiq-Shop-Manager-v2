    View accountCard(String name, double amount, String unit) {
        LinearLayout card = vertical();
        card.setPadding(13, 15, 8, 15);
        card.setBackground(shape(white, 16));
        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(0, 92, 1);
        p.setMargins(4, 4, 4, 4);
        card.addView(label(name, 11, green, true));
        card.addView(label(unit + " " + String.format(Locale.US, "%.0f", amount),
                19, dark, true));
        card.setLayoutParams(p);
        return card;
    }

    View menuButton(String title, String key) {
        TextView b = label(title, 14, dark, true);
        b.setGravity(Gravity.CENTER);
        b.setBackground(shape(white, 16));
        b.setElevation(2);
        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(0, 75, 1);
        p.setMargins(4, 5, 4, 5);
        b.setLayoutParams(p);
        b.setOnClickListener(v -> openModule(key));
        return b;
    }

    View reportButton(String title, String key) {
        TextView b = label(title, 13, green, true);
        b.setGravity(Gravity.CENTER);
        b.setBackground(shape(white, 12));
        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(0, 48, 1);
        p.setMargins(4, 3, 4, 3);
        b.setLayoutParams(p);
        b.setOnClickListener(v -> report(key));
        return b;
    }

    double total(String query) {
        Cursor c = db.getReadableDatabase().rawQuery(query, null);
        double value = 0;
        if (c.moveToFirst()) value = c.getDouble(0);
        c.close();
        return value;
    }

    double dailyIncome() {
        return total("SELECT IFNULL(SUM(service_fee),0) FROM bookings WHERE date='" + date() + "'");
    }

    double expenses() {
        return total("SELECT IFNULL(SUM(amount),0) FROM expenses WHERE date='" + date() + "'");
    }

    double due() {
        return total("SELECT IFNULL(SUM(due),0) FROM bookings");
    }

    double profit() {
        return dailyIncome() - expenses();
    }

    String date() {
        return new SimpleDateFormat("yyyy-MM-dd", Locale.US).format(new Date());
    }

    void openModule(String key) {
        switch (key) {
            case "booking": bookingForm(); break;
            case "expense": expenseForm(); break;
            case "khata": showRecords("Customer Khata",
                "SELECT name,mobile,total,paid,due FROM bookings ORDER BY id DESC"); break;
            case "nadra": serviceForm("NADRA / E-Sahulat"); break;
            case "vehicle": serviceForm("Vehicle Biometric"); break;
            case "printer": printerForm(); break;
            case "stock": stockForm(); break;
            case "internet": internetForm(); break;
        }
    }

    EditText field(LinearLayout box, String hint, boolean numeric) {
        EditText e = new EditText(this);
        e.setHint(hint);
        if (numeric) e.setInputType(2);
        box.addView(e);
        return e;
    }

    void bookingForm() {
        LinearLayout box = vertical();
        EditText name = field(box, "Customer Name", false);
        EditText mobile = field(box, "Mobile Number", true);
        EditText village = field(box, "Village", false);
        EditText service = field(box, "Service", false);
        EditText gov = field(box, "Government Fees", true);
        EditText fee = field(box, "Service Charges", true);
        EditText paid = field(box, "Amount Paid", true);

        formDialog("New Booking", box, () -> {
            double g = val(gov), f = val(fee), p = val(paid);
            if (name.getText().toString().trim().isEmpty() || g < 0 ||
                    f < 0 || p < 0 || p > g + f) {
                msg("Check customer name and amounts");
                return;
            }
            ContentValues v = new ContentValues();
            v.put("date", date());
            v.put("name", name.getText().toString());
            v.put("mobile", mobile.getText().toString());
            v.put("village", village.getText().toString());
            v.put("service", service.getText().toString());
            v.put("gov_fee", g);
            v.put("service_fee", f);
            v.put("total", g + f);
            v.put("paid", p);
            v.put("due", g + f - p);
            db.getWritableDatabase().insert("bookings", null, v);
            msg("Booking saved");
            home();
        });
    }

    void expenseForm() {
        LinearLayout box = vertical();
        EditText name = field(box, "Expense Name", false);
        EditText amount = field(box, "Amount", true);
        EditText details = field(box, "Details", false);
        formDialog("New Expense", box, () -> {
            if (val(amount) <= 0) { msg("Enter amount"); return; }
            ContentValues v = new ContentValues();
            v.put("date", date());
            v.put("category", name.getText().toString());
            v.put("details", details.getText().toString());
            v.put("amount", val(amount));
            db.getWritableDatabase().insert("expenses", null, v);
            msg("Expense saved");
            home();
        });
    }

    void serviceForm(String title) {
        LinearLayout box = vertical();
        EditText name = field(box, "Customer Name", false);
        EditText tracking = field(box, "Tracking ID", false);
        EditText ref = field(box, "Reference Code", false);
        EditText total = field(box, "Total Fees", true);
        EditText gov = field(box, "Government Fees", true);
        EditText paid = field(box, "Amount Paid", true);
        EditText issue = field(box, "Issue / Pad / Unpad Status", false);
        formDialog(title, box, () -> {
            ContentValues v = new ContentValues();
            v.put("date", date());
            v.put("name", name.getText().toString());
            v.put("tracking", tracking.getText().toString());
            v.put("reference", ref.getText().toString());
            v.put("total", val(total));
            v.put("gov", val(gov));
            v.put("paid", val(paid));
            v.put("status", issue.getText().toString());
            db.getWritableDatabase().insert("services", null, v);
            msg("Record saved");
            home();
        });
    }

    void printerForm() {
