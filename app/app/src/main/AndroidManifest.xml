        root.addView(row2);

        TextView services = label("SHOP SERVICES", 17, dark, true);
        services.setPadding(3, 20, 0, 10);
        root.addView(services);

        String[] names = {
            "＋  New Booking", "＋  New Expense",
            "▣  NADRA / E-Sahulat", "🚗  Vehicle Biometric",
            "▤  Printer & Paper", "▦  Stock & Material",
            "♙  Customer Khata", "◷  Internet Packages"
